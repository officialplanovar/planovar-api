generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CLIENT
  VENDOR
  ADMIN
}

enum PricingType {
  FIXED
  QUOTE
  STARTING_FROM
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum EventType {
  WEDDING
  BIRTHDAY
  ANNIVERSARY
  CORPORATE
  CONCERT
  BURIAL
  GRADUATION
  CONFERENCE
  OTHER
}

enum EventStatus {
  DRAFT
  PLANNING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED // replaced by a newer version; kept in history, no longer active
}

// How the payment is structured in a quote / invoice
enum QuotePaymentStructure {
  FULL_UPFRONT // client pays everything at once; released to vendor after service
  INSTALLMENTS // vendor defines multiple tranches with percentages + due dates
  CUSTOM_ESCROW // vendor and client agree on a fixed escrow amount; rest released immediately
}

enum InstallmentType {
  IMMEDIATE // released to vendor once paid (minus commission)
  ESCROW // held by Planovar until booking is completed
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum EscrowStatus {
  HELD
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
  SUBSCRIPTION
  ESCROW_HOLD
  ESCROW_RELEASE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionTier {
  BASIC
  PREMIUM
  GOLD
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum VendorBusinessType {
  LICENSED // registered/licensed business (CAC)
  FREELANCER // individual / sole operator
}

enum VendorType {
  PRODUCTS
  SERVICES
  BOTH
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum ConversationType {
  DIRECT // one client ↔ one vendor (tied to a booking)
  GROUP // one client + all vendors sourced for a single event
}

// All 14 message types used by the Flutter client.
// TEXT / IMAGE / FILE / VOICE — raw content messages
// QUOTE → INVOICE flow mirrors the booking lifecycle
// SYSTEM messages are generated by the backend (booking confirmations, etc.)
enum MessageType {
  // Content
  TEXT
  IMAGE
  FILE
  VOICE

  // Quote / invoice lifecycle
  INQUIRY // client's opening brief card ("View Event Details")
  QUOTE // vendor's negotiable proposal (versioned)
  QUOTE_REVISED // a newer version supersedes a previous quote
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  QUOTE_EXPIRED
  INVOICE // finalized bill from an accepted quote
  INVOICE_ACCEPTED
  INVOICE_DECLINED

  // Orders (direct products/rentals, no quote) + fulfilment
  ORDER_REQUEST // client requests a fixed product/rental
  ORDER_ACCEPTED
  ORDER_DECLINED
  TIMELINE_UPDATE // vendor progress: in production / out for delivery / delivered
  MILESTONE_PAID // a milestone payment succeeded
  DEPOSIT_REFUNDED // rental deposit returned

  // Booking & payment events (system-generated)
  BOOKING_CONFIRMED
  PAYMENT_CONFIRMED
  PAYMENT_PENDING
  BOOKING_CANCELLED

  // Post-service
  DISPUTE_RAISED
  REVIEW_REQUESTED
  REVIEW_SUBMITTED
  REFUND_REQUESTED

  // Group chat
  TODO // a to-do item card (group chat only)

  // Generic backend system message
  SYSTEM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_PAID
  PAID
  DECLINED
  CANCELLED
}

// What a booking/order actually is — drives the right fulfilment flow & UI.
enum FulfilmentType {
  PURCHASE // product bought outright
  SERVICE // service booking (quote → invoice)
  RENTAL // equipment rental (pickup/return, deposit)
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  INVOICE_RECEIVED
  INVOICE_ACCEPTED
  INVOICE_DECLINED
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  INSTALLMENT_DUE
  ESCROW_RELEASED
  PAYOUT_PROCESSED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  REVIEW_REQUESTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  REFUND_REQUESTED
  REFUND_PROCESSED
  SYSTEM
}

enum FavouriteType {
  VENDOR
  LISTING
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ─────────────────────────────────────────────
// GROUP 1 — IDENTITY & AUTH  (Better Auth owns these 4 tables)
// ─────────────────────────────────────────────
//
// Better Auth generates its own IDs (nanoid). We must NOT constrain these
// columns to uuid type — that's only for tables whose IDs we generate ourselves.
// All FK columns referencing user.id are also plain String (text) for the same reason.

model User {
  id            String   @id // Better Auth-generated ID — not a UUID
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Planovar domain fields — synced via Better Auth additionalFields config
  role              UserRole @default(CLIENT)
  phone             String?  @unique
  firstName         String?  @map("first_name")
  lastName          String?  @map("last_name")
  // Stored as a plain ISO date string (YYYY-MM-DD) — no time component needed.
  dateOfBirth       String?  @map("date_of_birth")
  isActive          Boolean  @default(true) @map("is_active")
  twoFactorEnabled  Boolean  @default(false) @map("two_factor_enabled")
  notificationPrefs Json?    @map("notification_prefs") // { push: bool, email: bool, inApp: bool, types: {...} }

  sessions Session[]
  accounts Account[]

  // Application relations
  vendorProfile            VendorProfile?
  clientProfile            ClientProfile?
  events                   Event[]
  bookingsAsClient         Booking[]                 @relation("ClientBookings")
  sentMessages             Message[]
  notifications            Notification[]
  deviceTokens             DevicePushToken[]
  reviews                  Review[]                  @relation("ReviewerReviews")
  disputes                 Dispute[]                 @relation("DisputeRaisedBy")
  auditLogs                AuditLog[]
  conversationsAsClient    Conversation[]            @relation("ClientConversations")
  conversationParticipants ConversationParticipant[]
  favourites               Favourite[]

  @@map("user")
}

model Session {
  id        String   @id // Better Auth-generated
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String // FK → user.id (text, not uuid)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id // Better Auth-generated
  accountId             String
  providerId            String
  userId                String // FK → user.id (text, not uuid)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id // Better Auth-generated
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────────
// GROUP 2 — VENDOR PROFILES
// ─────────────────────────────────────────────

model VendorProfile {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @unique @map("user_id") // FK → user.id (text)
  businessName           String              @map("business_name")
  slug                   String              @unique
  description            String?
  logoUrl                String?             @map("logo_url")
  coverUrl               String?             @map("cover_url")
  portfolioUrls          String[]            @map("portfolio_urls") // additional gallery images
  phone                  String?
  email                  String?
  businessType           VendorBusinessType? @map("business_type")
  vendorType             VendorType          @default(BOTH) @map("vendor_type")
  location               Json
  serviceRadiusKm        Int?                @map("service_radius_km")
  tags                   String[]
  ratingAvg              Decimal             @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount            Int                 @default(0) @map("review_count")
  subscriptionTier       SubscriptionTier    @default(BASIC) @map("subscription_tier")
  // ─── KYC / verification (KYC at signup; CAC for licensed vendors — MoM #11–12) ───
  kycStatus              KycStatus           @default(NOT_SUBMITTED) @map("kyc_status")
  ninDocumentUrl         String?             @map("nin_document_url")
  cacDocumentUrl         String?             @map("cac_document_url")
  kycSubmittedAt         DateTime?           @map("kyc_submitted_at")
  kycReviewedAt          DateTime?           @map("kyc_reviewed_at")
  kycReviewedBy          String?             @map("kyc_reviewed_by") // admin user.id
  kycRejectionReason     String?             @map("kyc_rejection_reason")
  isVerified             Boolean             @default(false) @map("is_verified")
  bankCode               String?             @map("bank_code")
  bankAccount            String?             @map("bank_account")
  bankName               String?             @map("bank_name") // for display
  accountName            String?             @map("account_name") // resolved via Paystack
  paystackRecipientCode  String?             @map("paystack_recipient_code") // Transfers API (payouts)
  // Split/subaccount code for DIRECT client→vendor pay (0% platform cut) — see direct-pay spike
  paystackSubaccountCode String?             @map("paystack_subaccount_code")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings              Listing[]
  bookings              Booking[]            @relation("VendorBookings")
  quotes                Quote[]
  payouts               Payout[]
  subscriptions         VendorSubscription[]
  reviews               Review[]             @relation("VendorReviews")
  reviewResponses       ReviewResponse[]
  conversationsAsVendor Conversation[]       @relation("VendorConversations")
  eventVendors          EventVendor[]
  invoices              Invoice[]

  @@index([subscriptionTier])
  @@index([ratingAvg])
  @@map("vendor_profiles")
}

// ─────────────────────────────────────────────
// GROUP 2b — LOCATIONS
// ─────────────────────────────────────────────

model Country {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  code      String  @unique // ISO 3166-1 alpha-2, e.g. "NG"
  dialCode  String  @map("dial_code") // e.g. "+234"
  flagEmoji String? @map("flag_emoji")
  isActive  Boolean @default(true) @map("is_active")

  cities         City[]
  clientProfiles ClientProfile[]

  @@map("countries")
}

model City {
  id        String  @id @default(uuid()) @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  name      String
  state     String? // state / region / province
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  isActive  Boolean @default(true) @map("is_active")

  country        Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  clientProfiles ClientProfile[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("cities")
}

// ─────────────────────────────────────────────
// GROUP 2c — CLIENT PROFILE & PREFERENCES
// ─────────────────────────────────────────────

model ClientProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") // FK → user.id (text)
  preferredCountryId String?  @map("preferred_country_id") @db.Uuid
  preferredCityId    String?  @map("preferred_city_id") @db.Uuid
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCountry Country?                 @relation(fields: [preferredCountryId], references: [id])
  preferredCity    City?                    @relation(fields: [preferredCityId], references: [id])
  categoryPrefs    UserCategoryPreference[]

  @@map("client_profiles")
}

model UserCategoryPreference {
  clientProfileId String   @map("client_profile_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([clientProfileId, categoryId])
  @@map("user_category_preferences")
}

// ─────────────────────────────────────────────
// GROUP 3 — LISTINGS & DISCOVERY
// ─────────────────────────────────────────────

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  slug            String   @unique
  description     String?
  iconUrl         String?  @map("icon_url")
  imageUrl        String?  @map("image_url") // full banner / card image for the UI
  // ─── Presentation & taxonomy (recommendation / search / browse metrics) ───
  color           String? // hex accent for chips/cards, e.g. "#5B50F0"
  tags            String[] @default([]) // editorial/browse tags shown to users
  keywords        String[] @default([]) // search synonyms/aliases — boosts recall ("DJ" → music)
  featured        Boolean  @default(false) // surface in recommendations / home rails
  popularityScore Int      @default(0) @map("popularity_score") // manual ranking boost (0 = neutral)
  metadata        Json? // extensible bag (seo copy, related-category ids, …)
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  parentId        String?  @map("parent_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  parent    Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]               @relation("CategoryTree")
  listings  Listing[]
  userPrefs UserCategoryPreference[]

  @@index([isActive, sortOrder])
  @@index([featured])
  @@map("categories")
}

model Listing {
  id                 String      @id @default(uuid()) @db.Uuid
  vendorId           String      @map("vendor_id") @db.Uuid
  categoryId         String      @map("category_id") @db.Uuid
  title              String
  description        String
  pricingType        PricingType @map("pricing_type")
  basePrice          Decimal?    @map("base_price") @db.Decimal(12, 2)
  priceUnit          String?     @map("price_unit")
  location           Json
  tags               String[]
  isActive           Boolean     @default(true) @map("is_active")
  isFeatured         Boolean     @default(false) @map("is_featured")
  viewCount          Int         @default(0) @map("view_count")
  ratingAvg          Decimal     @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount        Int         @default(0) @map("review_count")
  // Rentable product fields
  isRentable         Boolean     @default(false) @map("is_rentable")
  perDayRate         Decimal?    @map("per_day_rate") @db.Decimal(12, 2)
  depositAmount      Decimal?    @map("deposit_amount") @db.Decimal(12, 2)
  // Product catalog + service detail fields
  sku                String?     @map("sku")
  stockQuantity      Int?        @map("stock_quantity")
  durationValue      Int?        @map("duration_value")
  durationUnit       String?     @map("duration_unit") // Days | Hours | Mins
  cancellationPolicy String?     @map("cancellation_policy") // Flexible | Moderate | Strict
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  vendor        VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category      Category         @relation(fields: [categoryId], references: [id])
  media         ListingMedia[]
  packages      ListingPackage[]
  bookings      Booking[]
  eventListings EventListing[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@map("listings")
}

model ListingMedia {
  id        String    @id @default(uuid()) @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  url       String
  publicId  String?   @map("public_id") // Cloudinary / R2 public ID for deletion
  type      MediaType
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_media")
}

model ListingPackage {
  id          String   @id @default(uuid()) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  features    Json
  createdAt   DateTime @default(now()) @map("created_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([listingId])
  @@map("listing_packages")
}

// ─────────────────────────────────────────────
// GROUP 3b — EVENTS
// ─────────────────────────────────────────────
//
// An Event is a client's planned occasion. Multiple bookings (one per vendor)
// are grouped under a single event. Group conversations auto-created per event.

model Event {
  id            String      @id @default(uuid()) @db.Uuid
  clientId      String      @map("client_id") // FK → user.id (text)
  name          String
  type          EventType   @default(OTHER)
  status        EventStatus @default(DRAFT)
  eventDate     DateTime    @map("event_date")
  location      Json? // { address, city, state, lat, lng }
  guestCount    Int?        @map("guest_count")
  durationHours Int?        @map("duration_hours")
  budgetMin     Decimal?    @map("budget_min") @db.Decimal(12, 2)
  budgetMax     Decimal?    @map("budget_max") @db.Decimal(12, 2)
  coverUrl      String?     @map("cover_url")
  description   String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  client            User           @relation(fields: [clientId], references: [id])
  bookings          Booking[]
  eventVendors      EventVendor[]
  eventListings     EventListing[]
  groupConversation Conversation?  @relation("EventGroupConversation")

  @@index([clientId])
  @@index([status])
  @@index([eventDate])
  @@map("events")
}

// Junction: the specific products/services a client added to an event.
model EventListing {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([eventId, listingId])
  @@index([eventId])
  @@map("event_listings")
}

// Junction: tracks which vendors have been sourced for an event.
// Populated when a booking is confirmed, or manually by the client.
model EventVendor {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid // the booking that linked this vendor
  addedAt   DateTime @default(now()) @map("added_at")

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@map("event_vendors")
}

// ─────────────────────────────────────────────
// GROUP 4 — BOOKINGS
// ─────────────────────────────────────────────

model Booking {
  id             String          @id @default(uuid()) @db.Uuid
  clientId       String          @map("client_id") // FK → user.id (text)
  vendorId       String          @map("vendor_id") @db.Uuid
  listingId      String          @map("listing_id") @db.Uuid
  packageId      String?         @map("package_id") @db.Uuid // selected listing package, if any
  eventId        String?         @map("event_id") @db.Uuid // the event this booking belongs to
  status         BookingStatus   @default(PENDING)
  eventDate      DateTime        @map("event_date")
  eventLocation  Json            @map("event_location")
  requirements   String?
  quoteAmount    Decimal?        @map("quote_amount") @db.Decimal(12, 2)
  finalAmount    Decimal?        @map("final_amount") @db.Decimal(12, 2)
  platformFee    Decimal?        @map("platform_fee") @db.Decimal(12, 2) // legacy (0 under direct-pay)
  vendorPayout   Decimal?        @map("vendor_payout") @db.Decimal(12, 2)
  // ─── Fulfilment (product / service / rental) ───
  fulfilmentType FulfilmentType? @map("fulfilment_type")
  deliveryMethod DeliveryMethod? @map("delivery_method")
  deliveryFee    Decimal?        @map("delivery_fee") @db.Decimal(12, 2)
  depositAmount  Decimal?        @map("deposit_amount") @db.Decimal(12, 2) // rental refundable deposit
  lateFeePerDay  Decimal?        @map("late_fee_per_day") @db.Decimal(12, 2)
  pickupAt       DateTime?       @map("pickup_at")
  returnAt       DateTime?       @map("return_at")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  client        User                   @relation("ClientBookings", fields: [clientId], references: [id])
  vendor        VendorProfile          @relation("VendorBookings", fields: [vendorId], references: [id])
  listing       Listing                @relation(fields: [listingId], references: [id])
  package       ListingPackage?        @relation(fields: [packageId], references: [id])
  event         Event?                 @relation(fields: [eventId], references: [id])
  statusHistory BookingStatusHistory[]
  quotes        Quote[]
  transactions  Transaction[]
  escrowHolds   EscrowHold[] // legacy (no escrow under direct-pay)
  conversation  Conversation?
  invoice       Invoice?
  messages      Message[]              @relation("BookingMessages")
  review        Review?
  dispute       Dispute?

  @@index([clientId])
  @@index([vendorId])
  @@index([eventId])
  @@index([status])
  @@index([eventDate])
  @@map("bookings")
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  changedBy  String         @map("changed_by") // FK → user.id (text)
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

// ─────────────────────────────────────────────
// GROUP 4b — QUOTES & PAYMENT STRUCTURE
// ─────────────────────────────────────────────
//
// A Quote is the vendor's formal invoice sent to the client.
// It defines the total amount AND the payment structure (how/when it is paid).
// Once the client accepts a quote, the structure is LOCKED — immutable.
// To change terms, the current quote must be voided and a new one created.
//
// Payment structure options:
//   FULL_UPFRONT    → client pays everything at once, held in full until booking completes
//   INSTALLMENTS    → vendor defines tranches (e.g. 40% now, 40% on-day, 20% on-completion)
//   CUSTOM_ESCROW   → one agreed escrow amount; rest released immediately to vendor

model Quote {
  id               String                @id @default(uuid()) @db.Uuid
  quoteNumber      String?               @unique @map("quote_number") // e.g. QT-2026-047
  bookingId        String?               @map("booking_id") @db.Uuid // optional: a quote precedes the booking
  vendorId         String                @map("vendor_id") @db.Uuid
  clientId         String?               @map("client_id") // FK → user.id (text)
  conversationId   String?               @map("conversation_id") @db.Uuid // sent in-chat (DM only)
  listingId        String?               @map("listing_id") @db.Uuid
  eventId          String?               @map("event_id") @db.Uuid
  amount           Decimal               @db.Decimal(12, 2)
  description      String?
  notes            String?
  // Proposed milestone terms (label, %, dueLabel) — materialized into PaymentMilestone on invoice
  paymentTerms     Json?                 @map("payment_terms")
  validUntil       DateTime              @map("valid_until")
  status           QuoteStatus           @default(PENDING)
  // ─── Versioning: a revised quote supersedes its parent; old versions stay traceable ───
  version          Int                   @default(1)
  isActive         Boolean               @default(true) @map("is_active") // false once superseded/expired/accepted-elsewhere
  parentQuoteId    String?               @map("parent_quote_id") @db.Uuid // previous version in the chain
  paymentStructure QuotePaymentStructure @default(FULL_UPFRONT) @map("payment_structure")
  // For CUSTOM_ESCROW — what % of total is held until service completion
  escrowPercentage Decimal?              @map("escrow_percentage") @db.Decimal(5, 2)
  // Locked once client accepts — prevents modification of agreed terms
  isLocked         Boolean               @default(false) @map("is_locked")
  lockedAt         DateTime?             @map("locked_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  booking      Booking?             @relation(fields: [bookingId], references: [id])
  vendor       VendorProfile        @relation(fields: [vendorId], references: [id])
  conversation Conversation?        @relation(fields: [conversationId], references: [id])
  parentQuote  Quote?               @relation("QuoteVersions", fields: [parentQuoteId], references: [id])
  revisions    Quote[]              @relation("QuoteVersions")
  lineItems    QuoteLineItem[]
  installments PaymentInstallment[] // legacy escrow tranches; new flow uses Invoice.milestones
  invoice      Invoice?
  messages     Message[]            @relation("QuoteMessages")

  @@index([bookingId])
  @@index([conversationId])
  @@map("quotes")
}

// Individual line items on a quote (e.g. "Setup fee", "Travel", "Photography day-of")
model QuoteLineItem {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

// A single payment tranche within a quote's payment plan.
// For FULL_UPFRONT — one installment at 100%, type ESCROW.
// For INSTALLMENTS — multiple rows, each with a percentage and due date.
// For CUSTOM_ESCROW — two rows: one IMMEDIATE (agreed free amount), one ESCROW (held amount).
model PaymentInstallment {
  id         String            @id @default(uuid()) @db.Uuid
  quoteId    String            @map("quote_id") @db.Uuid
  label      String // e.g. "Deposit", "Final payment"
  percentage Decimal           @db.Decimal(5, 2) // % of quote total (e.g. 40.00)
  amount     Decimal           @db.Decimal(12, 2) // computed: percentage × total
  type       InstallmentType   @default(IMMEDIATE)
  status     InstallmentStatus @default(PENDING)
  dueAt      DateTime?         @map("due_at") // null = pay anytime
  paidAt     DateTime?         @map("paid_at")
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  escrowHold   EscrowHold?

  @@index([quoteId])
  @@map("payment_installments")
}

// ─────────────────────────────────────────────
// GROUP 5 — PAYMENTS & FINANCE
// ─────────────────────────────────────────────

// Tracks a specific amount of money held by Planovar on behalf of the client
// before it is released to the vendor. Created when an ESCROW installment is paid.
model EscrowHold {
  id            String       @id @default(uuid()) @db.Uuid
  bookingId     String       @map("booking_id") @db.Uuid
  installmentId String?      @unique @map("installment_id") @db.Uuid
  amount        Decimal      @db.Decimal(12, 2)
  status        EscrowStatus @default(HELD)
  heldAt        DateTime     @default(now()) @map("held_at")
  releasedAt    DateTime?    @map("released_at")
  releasedBy    String?      @map("released_by") // FK → user.id (admin or system)
  releaseReason String?      @map("release_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  booking     Booking             @relation(fields: [bookingId], references: [id])
  installment PaymentInstallment? @relation(fields: [installmentId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("escrow_holds")
}

model Transaction {
  id                   String          @id @default(uuid()) @db.Uuid
  bookingId            String?         @map("booking_id") @db.Uuid
  installmentId        String?         @map("installment_id") @db.Uuid
  userId               String          @map("user_id") // FK → user.id (text)
  type                 TransactionType
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("NGN")
  paystackReference    String?         @unique @map("paystack_reference")
  flutterwaveReference String?         @unique @map("flutterwave_reference")
  paystackStatus       String?         @map("paystack_status")
  metadata             Json?
  createdAt            DateTime        @default(now()) @map("created_at")

  booking         Booking?            @relation(fields: [bookingId], references: [id])
  installment     PaymentInstallment? @relation(fields: [installmentId], references: [id])
  payoutLineItems PayoutLineItem[]

  @@index([bookingId])
  @@index([userId])
  @@index([paystackReference])
  @@map("transactions")
}

model Payout {
  id                   String       @id @default(uuid()) @db.Uuid
  vendorId             String       @map("vendor_id") @db.Uuid
  amount               Decimal      @db.Decimal(12, 2)
  status               PayoutStatus @default(PENDING)
  scheduledAt          DateTime     @map("scheduled_at")
  processedAt          DateTime?    @map("processed_at")
  paystackTransferCode String?      @map("paystack_transfer_code")
  failureReason        String?      @map("failure_reason")
  createdAt            DateTime     @default(now()) @map("created_at")

  vendor    VendorProfile    @relation(fields: [vendorId], references: [id])
  lineItems PayoutLineItem[]

  @@index([vendorId])
  @@index([status])
  @@map("payouts")
}

model PayoutLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  payoutId       String   @map("payout_id") @db.Uuid
  transactionId  String   @map("transaction_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  // Commission rate stored at payout time — immutable even if vendor changes tier
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  payout      Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([payoutId])
  @@map("payout_line_items")
}

model SubscriptionPlan {
  id             String           @id @default(uuid()) @db.Uuid
  tier           SubscriptionTier @unique
  name           String
  priceMonthly   Decimal          @map("price_monthly") @db.Decimal(12, 2)
  priceYearly    Decimal          @default(0) @map("price_yearly") @db.Decimal(12, 2)
  currency       String           @default("USD")
  // null = unlimited (Gold); 0 = no listings (Basic); N = max active listings
  listingLimit   Int?             @map("listing_limit")
  // Deprecated under subscription-only mode (4 June MoM). Kept @default(0) so the
  // shelved transactional code (payments/payouts) still compiles. Not used for billing.
  commissionRate Decimal          @default(0) @map("commission_rate") @db.Decimal(5, 4)
  features       Json
  createdAt      DateTime         @default(now()) @map("created_at")

  vendorSubscriptions VendorSubscription[]

  @@map("subscription_plans")
}

model VendorSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  vendorId               String             @map("vendor_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(ACTIVE)
  billingCycle           BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  // Provider-agnostic billing (src/modules/billing): stripe | paystack | paypal | iap
  provider               String?
  providerSubscriptionId String?            @map("provider_subscription_id")
  cancelledAt            DateTime?          @map("cancelled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  vendor VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([providerSubscriptionId])
  @@map("vendor_subscriptions")
}

// Anti-duplicate-signup ledger (MoM #18): records each consumed free vendor trial
// keyed by device and phone, so the 45-day trial can't be farmed across accounts.
model TrialClaim {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  deviceId  String?  @map("device_id")
  phone     String?
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@index([deviceId])
  @@index([phone])
  @@map("trial_claims")
}

// Admin-editable commission rates per tier.
// These override the COMMISSION_RATE_* env vars when present.
// Seeded with the default rates on first deploy.
model CommissionConfig {
  id        String           @id @default(uuid()) @db.Uuid
  tier      SubscriptionTier @unique
  rate      Decimal          @db.Decimal(5, 4) // e.g. 0.0800 = 8%
  updatedBy String?          @map("updated_by") // FK → user.id (admin)
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("commission_config")
}

// ─────────────────────────────────────────────
// GROUP 6 — MESSAGING & COMMUNICATION
// ─────────────────────────────────────────────
//
// Conversation types:
//   DIRECT → one client ↔ one vendor. clientId + vendorId both set. Tied to a booking.
//   GROUP  → one client + all sourced vendors for an event. vendorId is null.
//            Members tracked via ConversationParticipant.
//
// For both types, ConversationParticipant tracks per-user unread counts.

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType @default(DIRECT)
  bookingId     String?          @unique @map("booking_id") @db.Uuid
  // For DIRECT conversations
  clientId      String           @map("client_id") // FK → user.id (text)
  vendorId      String?          @map("vendor_id") @db.Uuid // null for GROUP conversations
  // For GROUP conversations
  eventId       String?          @unique @map("event_id") @db.Uuid
  groupName     String?          @map("group_name")
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  client       User                      @relation("ClientConversations", fields: [clientId], references: [id])
  vendor       VendorProfile?            @relation("VendorConversations", fields: [vendorId], references: [id])
  event        Event?                    @relation("EventGroupConversation", fields: [eventId], references: [id])
  messages     Message[]
  participants ConversationParticipant[]
  quotes       Quote[]
  invoices     Invoice[]
  todos        Todo[]

  @@index([clientId])
  @@index([vendorId])
  @@index([eventId])
  @@map("conversations")
}

// Tracks every participant in a conversation (both DIRECT and GROUP).
// Used for: per-user unread counts, last-read pointer, group membership.
// For DIRECT: two rows — the client and the vendor user.
// For GROUP: one row per member (client + all vendor users).
model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") // FK → user.id (text)
  unreadCount    Int       @default(0) @map("unread_count")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") // FK → user.id (text)
  content        String?
  type           MessageType @default(TEXT)
  // For VOICE messages — stored in Cloudinary under planovar/voice_notes/
  voiceUrl       String?     @map("voice_url")
  voiceDuration  Int?        @map("voice_duration") // seconds
  // Structured-card references — set on the matching MessageType
  quoteId        String?     @map("quote_id") @db.Uuid // QUOTE / QUOTE_REVISED / QUOTE_*
  invoiceId      String?     @map("invoice_id") @db.Uuid // INVOICE / INVOICE_*
  bookingId      String?     @map("booking_id") @db.Uuid // ORDER_REQUEST / TIMELINE_UPDATE / BOOKING_*
  todoId         String?     @map("todo_id") @db.Uuid // TODO (group chat)
  // Generic snapshot for system/inline cards (milestone paid, amounts, status labels, etc.)
  metadata       Json?
  isRead         Boolean     @default(false) @map("is_read")
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  quote        Quote?              @relation("QuoteMessages", fields: [quoteId], references: [id])
  invoice      Invoice?            @relation("InvoiceMessages", fields: [invoiceId], references: [id])
  booking      Booking?            @relation("BookingMessages", fields: [bookingId], references: [id])
  todo         Todo?               @relation("TodoMessages", fields: [todoId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  url       String
  publicId  String?  @map("public_id") // Cloudinary / R2 public ID for deletion
  fileName  String?  @map("file_name") // original filename
  fileType  String   @map("file_type") // MIME type
  fileSize  Int      @map("file_size") // bytes
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

// ─────────────────────────────────────────────
// GROUP 6b — CHAT-ORDER DOMAIN (invoice · milestones · to-dos)
// Direct-pay model: the client pays the vendor directly via a Paystack subaccount
// (0% platform cut); invoices + milestones are the source of truth for payable
// amounts. Legacy escrow models (EscrowHold, PaymentInstallment, CommissionConfig)
// are superseded under this model.
// ─────────────────────────────────────────────

// A finalized bill generated from an ACCEPTED quote. Sent in a DM; accepting it
// creates/confirms the Booking. Carries the payable milestone schedule.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") // e.g. INV-2026-047
  quoteId        String?       @unique @map("quote_id") @db.Uuid // the accepted quote it derives from
  conversationId String        @map("conversation_id") @db.Uuid // always sent in a DM
  bookingId      String?       @unique @map("booking_id") @db.Uuid // set once accepted → booking created
  vendorId       String        @map("vendor_id") @db.Uuid
  clientId       String        @map("client_id") // FK → user.id (text)
  eventId        String?       @map("event_id") @db.Uuid
  listingId      String?       @map("listing_id") @db.Uuid
  subtotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(SENT)
  notes          String?
  issuedAt       DateTime      @default(now()) @map("issued_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  quote        Quote?             @relation(fields: [quoteId], references: [id])
  conversation Conversation       @relation(fields: [conversationId], references: [id])
  booking      Booking?           @relation(fields: [bookingId], references: [id])
  vendor       VendorProfile      @relation(fields: [vendorId], references: [id])
  lineItems    InvoiceLineItem[]
  milestones   PaymentMilestone[]
  messages     Message[]          @relation("InvoiceMessages")

  @@index([conversationId])
  @@index([vendorId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// One payable tranche of an invoice (e.g. "50% on confirmation", "50% 7 days before").
// Paid via Paystack directly to the vendor's subaccount — no escrow, 0% platform cut.
// `amount` is the vendor's net; `feeAmount` is the Paystack fee the client bears on top.
model PaymentMilestone {
  id                String            @id @default(uuid()) @db.Uuid
  invoiceId         String            @map("invoice_id") @db.Uuid
  label             String // "Milestone 1 · Now"
  dueLabel          String?           @map("due_label") // "Due on confirmation"
  percentage        Decimal           @db.Decimal(5, 2)
  amount            Decimal           @db.Decimal(12, 2) // vendor net for this tranche
  feeAmount         Decimal?          @map("fee_amount") @db.Decimal(12, 2) // Paystack fee client pays
  status            InstallmentStatus @default(PENDING)
  dueAt             DateTime?         @map("due_at")
  paidAt            DateTime?         @map("paid_at")
  paystackReference String?           @map("paystack_reference") // charge reference
  sortOrder         Int               @default(0) @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@map("payment_milestones")
}

// A to-do item inside an event GROUP chat. Each assignee ticks off their own row.
model Todo {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  createdBy      String    @map("created_by") // FK → user.id (text)
  title          String
  description    String?
  dueAt          DateTime? @map("due_at") // combined date + time
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignments  TodoAssignment[]
  messages     Message[]        @relation("TodoMessages")

  @@index([conversationId])
  @@map("todos")
}

// Per-member completion of a Todo — every assignee ticks their own.
model TodoAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  todoId    String    @map("todo_id") @db.Uuid
  userId    String    @map("user_id") // FK → user.id (text)
  isDone    Boolean   @default(false) @map("is_done")
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([todoId])
  @@map("todo_assignments")
}

// ─────────────────────────────────────────────
// GROUP 7 — REVIEWS & TRUST
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  reviewerId String   @map("reviewer_id") // FK → user.id (text)
  vendorId   String   @map("vendor_id") @db.Uuid
  rating     Int
  title      String?
  body       String
  isVerified Boolean  @default(true) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  booking  Booking         @relation(fields: [bookingId], references: [id])
  reviewer User            @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  vendor   VendorProfile   @relation("VendorReviews", fields: [vendorId], references: [id])
  response ReviewResponse?

  @@index([vendorId])
  @@map("reviews")
}

model ReviewResponse {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @unique @map("review_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendorId], references: [id])

  @@map("review_responses")
}

// ─────────────────────────────────────────────
// GROUP 8 — PLATFORM OPERATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") // FK → user.id (text)
  type      NotificationType
  title     String
  body      String
  // Routing data for deep-linking — e.g. { bookingId, conversationId, quoteId }
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// FCM / APNs push tokens per user-device pair.
// One user can have multiple devices. Tokens are upserted on each app launch.
model DevicePushToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") // FK → user.id (text)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_push_tokens")
}

// User-saved vendors and listings.
model Favourite {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") // FK → user.id (text)
  type        FavouriteType
  // For VENDOR: references vendor_profiles.id (UUID stored as text for flexibility)
  // For LISTING: references listings.id
  referenceId String        @map("reference_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Polymorphic reference: referenceId points to a listing OR a vendor
  // depending on `type`. No hard FK so both kinds can be stored; the owning
  // rows are fetched manually in the service.

  @@unique([userId, type, referenceId])
  @@index([userId, type])
  @@map("favourites")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @unique @map("booking_id") @db.Uuid
  raisedBy    String        @map("raised_by") // FK → user.id (text)
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedBy  String?       @map("resolved_by") // FK → user.id (text)
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  raiser  User    @relation("DisputeRaisedBy", fields: [raisedBy], references: [id])

  @@index([status])
  @@map("disputes")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") // FK → user.id (text)
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
