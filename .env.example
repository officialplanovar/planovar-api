# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Per-request HTTP logging ([HTTP] METHOD path status ms). On in dev; set false to silence.
LOG_REQUESTS=true

# ─── Platform mode (4 June 2026 MoM: subscription-only) ─────────────────────
# false = no in-platform transactions (payouts/escrow/order payments are 404'd).
# Flip to true to re-enable the shelved transactional surface.
TRANSACTIONS_ENABLED=false
# Active subscription billing rail: stripe | paystack | paypal | iap
PAYMENT_PROVIDER=paystack
API_BASE_URL=http://localhost:3000

# ─── Better Auth ────────────────────────────────────────────────────────────
# Generate with: npx auth secret
BETTER_AUTH_SECRET=change-me-in-production
# Comma-separated list of trusted frontend origins (added to the dev defaults)
BETTER_AUTH_TRUSTED_ORIGINS=
# Require email OTP verification before sign-in (keep false in dev; true for staging/prod)
REQUIRE_EMAIL_VERIFICATION=false

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/planovar_dev?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Google OAuth ───────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple OAuth (Sign in with Apple) ───────────────────────────────────────
# developer.apple.com → Certificates, Identifiers & Profiles
# See docs/infrastructure.md § 3 for full setup instructions
APPLE_SERVICE_ID=ng.planovar.signin
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Encode newlines as \n inside a double-quoted value
APPLE_PRIVATE_KEY=
# The signed client-secret JWT generated from the key above (required to enable Apple OAuth).
APPLE_CLIENT_SECRET=
# iOS app bundle id — enables native Sign in with Apple token validation
APPLE_APP_BUNDLE_ID=ng.planovar.vendor

# ─── Cloudinary (file & media storage) ──────────────────────────────────────
# cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 'cloudinary' | 'r2'  — switch here to change provider, no code change needed
UPLOAD_PROVIDER=cloudinary

# ─── Cloudflare R2 (future storage fallback) ────────────────────────────────
# Populated when migrating away from Cloudinary free tier
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=planovar-dev
R2_PUBLIC_URL=

# ─── Subscription billing rails (provider-agnostic; pick one via PAYMENT_PROVIDER) ──
# Subscriptions are billed in USD. Each rail is wired behind the PaymentProvider
# interface (src/modules/billing) so the active provider is swappable via env.

# Paystack — Nigerian local cards/bank. dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=xxxx
PAYSTACK_SUBACCOUNT_ENABLED=false
# Recurring billing: paste the Paystack Plan codes (dashboard → Subscriptions →
# Plans). When set, a paid subscribe creates a recurring Paystack subscription;
# when blank, it falls back to a one-time charge. Codes look like PLN_xxxxxxxx.
PAYSTACK_PLAN_PREMIUM_MONTHLY=
PAYSTACK_PLAN_PREMIUM_YEARLY=
PAYSTACK_PLAN_GOLD_MONTHLY=
PAYSTACK_PLAN_GOLD_YEARLY=

# Stripe — USD / international cards + recurring subscriptions
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs per tier/cycle (created in Stripe dashboard)
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=

# PayPal — wallet option
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Apple/Google in-app purchase (mobile store subscriptions; web stays on card rails)
APPLE_IAP_SHARED_SECRET=
APPLE_ISSUER_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ─── Flutterwave (payment fallback) ─────────────────────────────────────────
# dashboard.flutterwave.com → Settings → API
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ─── Firebase (push notifications) ──────────────────────────────────────────
# console.firebase.google.com → Project settings → Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Encode newlines as \n inside a double-quoted value
FIREBASE_PRIVATE_KEY=

# ─── LiveKit (in-app voice & video calls) ────────────────────────────────────
# cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Resend (transactional email) ───────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM=noreply@planovar.ng
# Public URL of the hosted logo PNG shown in email headers (use the DARK-background
# variant — email headers are navy). Until set, a styled wordmark fallback is used.
EMAIL_LOGO_URL=

# ─── Typesense (search & recommendations) ───────────────────────────────────
# Dev: auto-configured via Docker. Production: cloud.typesense.org
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# ─── Commission rates (platform fee per subscription tier) ───────────────────
# Decimal format: 0.08 = 8%. Editable here or via admin dashboard (takes precedence).
COMMISSION_RATE_BASIC=0.08
COMMISSION_RATE_FEATURED=0.055
COMMISSION_RATE_PREMIUM=0.03

# ─── JWT (service-to-service, not used for client auth) ─────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── Sentry (error monitoring — production only) ─────────────────────────────
SENTRY_DSN=
